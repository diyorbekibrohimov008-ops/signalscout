  "description": "Free buying-intent reader that finds people asking for a tool like yours on Reddit, X, LinkedIn, and Hacker News.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"import('vite').then(({ build }) => build())\"",
