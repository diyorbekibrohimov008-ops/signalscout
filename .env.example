# SignalScout Environment Variables (optional — Netlify DB & Netlify AI Gateway auto-configure in production)
# Signed session cookie secret (auto-falls back in dev, set a 32+ char random secret in production)
SESSION_SECRET=replace-with-32-plus-char-random-secret

# Optional: Bring your own OpenAI key (otherwise uses Netlify AI Gateway when deployed, or built-in intent engine)
OPENAI_API_KEY=

# Optional: Channel API credentials (Hacker News & Reddit public search work out of the box)
X_BEARER_TOKEN=
APIFY_API_TOKEN=
REDDIT_USER_AGENT=SignalScout/1.0 (+https://signalscout.app)

# Optional: Cron webhook authorization secret for scheduled monitor execution
CRON_SECRET=
